          }}
          onDragLeave={() => setIsDragging(false)}
          onDrop={handleDrop}
        >
          <p className="text-sm font-medium text-slate-800">
            拖拽 ChatGPT JSON 文件到这里
          </p>
          <p className="mt-1 text-xs text-slate-500">
            或选择本地 `.json` 文件，所有解析都在浏览器本地完成。
          </p>
          <input
