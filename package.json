{
  "name": "save-chatgpt-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Export ChatGPT conversations to Markdown from local JSON files.",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wxt-dev/module-react": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "jsdom": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vitest": "latest",
    "wxt": "latest"
  }
}
